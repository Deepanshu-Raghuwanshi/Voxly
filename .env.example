# ─── Infrastructure ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voxyl_db
MONGO_USER=admin
MONGO_PASSWORD=admin
REDIS_PASSWORD=redis_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-random-32-char-secret-value
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-access-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Google OAuth (optional — omit to disable Google login) ───────────────────
# Get credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── SMTP — transactional email (optional — omit to skip email sending) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Database URLs ─────────────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voxyl_db?schema=public
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voxyl_db?schema=public
MONGODB_URL=mongodb://admin:admin@localhost:27017/voxyl_messages?authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Service URLs (API Gateway) ───────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CHAT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3005

# ─── Cloudinary — avatar uploads (https://cloudinary.com) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:4200

# ─── AI — Groq (https://console.groq.com) ────────────────────────────────────
GROQ_API_KEY=

# ─── AI — Cerebras fallback (https://cloud.cerebras.ai) ──────────────────────
CEREBRAS_API_KEY=

# ─── AI — Tavily web search (https://app.tavily.com) ─────────────────────────
TAVILY_API_KEY=

# ─── AI — OpenWeatherMap (https://openweathermap.org/api) ────────────────────
OPENWEATHER_API_KEY=
